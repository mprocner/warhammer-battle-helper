[Unit]
Description=Warhammer Battle Helper Auto-Deploy Watcher
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/warhammer-battle-helper
ExecStart=/home/ubuntu/warhammer-battle-helper/scripts/autopull.sh
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
