# Production Environment Variables
# Copy this file to .env.prod and update the values

# Frontend API URL (your domain with /api path or backend URL)
REACT_APP_API_URL=https://yourdomain.com/api

# Google Analytics 4 — identyfikator strumienia danych (format G-XXXXXXXXXX).
# Puste = analityka wyłączona, baner zgody się nie pokazuje.
REACT_APP_GA_MEASUREMENT_ID=

# Admin panel base path — /admin when served behind nginx at /admin/
ADMIN_BASENAME=/admin

# MongoDB credentials (change these!)
MONGO_USER=root
MONGO_PASSWORD=your-secure-password-here
MONGO_DB_NAME=battle_helper

# CORS - Add your domain(s) here (comma-separated)
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

SMTP_HOST=ssl0.ovh.net
SMTP_PORT=587
SMTP_USER=noreply@playrpg.net
SMTP_PASSWORD=<haslo>
SMTP_FROM=noreply@playrpg.net
APP_URL=https://playrpg.net

# Skrzynka, na którą backend wysyła wiadomości z formularza /contact (zgłoszenia błędów i treści).
# Reply-To ustawiany jest na adres zgłaszającego. Puste = contact@playrpg.net.
CONTACT_EMAIL=contact@playrpg.net

# Adresy/CIDR proxy, którym backend wierzy w nagłówkach X-Real-IP / X-Forwarded-For (limit
# wiadomości z formularza kontaktowego liczony jest per IP klienta). Puste = loopback + sieci
# prywatne (nginx na hoście łączy się z kontenerem przez bramę sieci Dockera 172.16.0.0/12).
TRUSTED_PROXIES=
