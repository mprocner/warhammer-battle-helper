### Profil użytkownika (użyj tokenu z odpowiedzi logowania)
# Replace YOUR_TOKEN with actual token from login response
GET http://localhost:8080/profile
Authorization: Bearer YOUR_TOKEN

###

### Moje postacie
GET http://localhost:8080/my-characters
Authorization: Bearer YOUR_TOKEN

###

### Utwórz nową postać
POST http://localhost:8080/my-characters
Content-Type: application/json
Authorization: Bearer YOUR_TOKEN

{
  "basicInfo": {
    "name": "Sigmar the Brave",
    "race": "Human",
    "class": "Warrior",
    "profession": "Soldier",
    "type": "hero"
  },
  "characteristics": {
    "WW": {"base": 40, "advances": 10},
    "US": {"base": 35, "advances": 5},
    "S": {"base": 35, "advances": 0},
    "Wt": {"base": 35, "advances": 5},
    "I": {"base": 40, "advances": 10},
    "Zw": {"base": 30, "advances": 0},
    "Zr": {"base": 35, "advances": 5},
    "Int": {"base": 30, "advances": 0},
    "SW": {"base": 35, "advances": 5},
    "Ogd": {"base": 30, "advances": 0}
  },
  "skills": {
    "Melee": 50,
    "Athletics": 40,
    "Dodge": 35
  },
  "weapons": [
    {"name": "Longsword", "bonus": 5},
    {"name": "Shield", "bonus": 2}
  ],
  "avatar": "https://example.com/avatar/sigmar.png"
